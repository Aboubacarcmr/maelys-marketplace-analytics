FROM apache/airflow:3.1.8-python3.12
USER airflow
# La version d'Airflow est fixée pour éviter une mise à jour implicite lors du pip install.
RUN pip install --no-cache-dir \
    'apache-airflow==3.1.8' \
    'apache-airflow-providers-postgres>=6.0,<7.0' \
    'apache-airflow-providers-fab>=3.0,<4.0' \
    'apache-airflow-providers-amazon>=9.0,<10.0' \
    'pytest>=8,<10' 'requests>=2.31,<3'
